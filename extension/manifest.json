{
  "manifest_version": 3,
  "name": "Airplay Flixer",
  "version": "0.15.1",
  "description": "Envoie la vidéo de l’onglet et ses sous-titres à ton Apple TV avec le compagnon Mac.",
  "permissions": [
    "activeTab",
    "scripting",
    "webRequest",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Airplay Flixer · Aucun flux vidéo détecté",
    "default_icon": {
      "16": "icons/idle-16.png",
      "24": "icons/idle-24.png",
      "32": "icons/idle-32.png",
      "48": "icons/idle-48.png",
      "64": "icons/idle-64.png",
      "128": "icons/idle-128.png"
    }
  },
  "commands": {
    "cast-current": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "Caster la vidéo sur l’Apple TV favorite"
    }
  },
  "key": "",
  "icons": {
    "16": "icons/brand-16.png",
    "32": "icons/brand-32.png",
    "48": "icons/brand-48.png",
    "128": "icons/brand-128.png"
  }
}
